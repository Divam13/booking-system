{
  "name": "railbook",
  "version": "1.0.0",
  "description": "IRCTC-style railway ticket booking system with segment-based seat allocation",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "setup": "tsx src/setup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/bitmask.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "load-test": "tsx tests/load-test.ts"
  },
  "keywords": ["railway", "booking", "irctc", "tickets"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
